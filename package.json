{
  "name": "@fand/glide",
  "version": "0.1.0",
  "description": "Markdown slideshow with GPU transitions",
  "type": "module",
  "repository": "https://github.com/fand/glide",
  "author": "AMAGI <mail@amagi.dev>",
  "license": "MIT",
  "bin": {
    "glide": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/glide.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:runtime && pnpm run build:types && pnpm run build:cli",
    "build:runtime": "vite build",
    "build:types": "tsc -p tsconfig.types.json && node scripts/fix-types.js",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --banner:js='#!/usr/bin/env node' --outfile=dist/cli.js",
    "start": "node scripts/start.js",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build"
  },
  "dependencies": {
    "@vfx-js/core": "^1.3.0",
    "@vfx-js/effects": "^1.4.1",
    "chokidar": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "keywords": [
    "markdown",
    "presentation",
    "slides",
    "transition",
    "webgl"
  ]
}
